{
  "name": "besu-qbft-v5-room-evaluation",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "generate:eoa": "node scripts/generate-eoa.js",
    "network:check": "node scripts/network-check.js",
    "room:test": "hardhat run scripts/run-room-test.js --network besu",
    "room:reset": "node scripts/room-reset.js",
    "room:add-voter": "node scripts/room-add-voter.js",
    "room:add-candidate": "node scripts/room-add-candidate.js",
    "room:start": "node scripts/room-start.js",
    "room:stop": "node scripts/room-stop.js",
    "room:vote": "node scripts/room-vote.js",
    "room:inspect": "hardhat run scripts/inspect-room.js --network besu",
    "sampling:smoke": "node scripts/sampling-smoke.js",
    "sampling:baseline": "node scripts/sampling-baseline.js",
    "sampling:main": "node scripts/sampling-main.js",
    "sampling:fault": "node scripts/sampling-fault-tolerance.js",
    "sampling:tps-smoke": "node scripts/sampling-tps-smoke.js",
    "sampling:tps-baseline": "node scripts/sampling-tps-baseline.js",
    "sampling:tps-batch": "node scripts/sampling-tps-batch.js",
    "sampling:tps-main": "node scripts/sampling-tps-main.js",
    "sampling:tps-fault": "node scripts/sampling-tps-fault-tolerance.js",
    "sampling:tps-stress-batch": "node scripts/sampling-tps-stress-batch.js",
    "sampling:tps-stress-main": "node scripts/sampling-tps-stress-main.js",
    "sampling:tps-stress-main:safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tps-stress-main-safe.ps1",
    "sampling:tps-stress-main:basic-safe": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tps-stress-main-basic-safe.ps1",
    "sampling:tps-stress-main:recovery-detailed": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run-tps-stress-main-recovery-detailed.ps1"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "^3.0.8",
    "@openzeppelin/contracts": "^5.0.2",
    "ethers": "^6.13.5",
    "hardhat": "^2.22.19"
  }
}
